# Copy to frontend/.env.local
# Where the Next.js server forwards /api/* (server-side only; never exposed to the browser).
API_INTERNAL_URL=http://127.0.0.1:8000
# Body-size limit for uploads that pass through the Next.js proxy. Keep it at least
# UPLOAD_HARD_MAX_BYTES. In production, prefer routing /api/* straight to the API
# at your reverse proxy so uploads never pass through Node (docs/deployment.md).
UPLOAD_PROXY_MAX_BODY=210mb
NEXT_TELEMETRY_DISABLED=1
