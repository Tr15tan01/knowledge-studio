# =============================================================================
# Knowledge Studio configuration
# Copy to `.env` in the repository root (scripts/setup.ps1 does this and generates
# SESSION_SECRET). The API and worker read ../.env or ./.env; the frontend reads
# frontend/.env.local (see frontend/.env.example).
#
# Never commit .env. Secrets live only in environment variables: they are never stored
# in the database and never shown in the admin panel.
# Booleans: 1/0 or true/false.
# =============================================================================

# --- Application -------------------------------------------------------------------
# development | test | staging | production   (staging/production enforce secure settings)
APP_ENV=development
APP_NAME=Knowledge Studio
# Public URL of the web app (used in emails, OAuth and Paddle redirects, origin checks)
APP_PUBLIC_URL=http://localhost:3000
# Public URL of the API (informational; browsers reach the API through the web origin)
API_PUBLIC_URL=http://localhost:8000
# Comma-separated origins allowed to call the API with credentials (APP_PUBLIC_URL is always allowed)
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# JSON logs for production log pipelines; set 0 for readable local logs
LOG_JSON=0

# --- MongoDB Atlas -----------------------------------------------------------------------
# Use the SRV connection string from Atlas (Database > Connect > Drivers).
MONGODB_URI=
MONGODB_DATABASE=knowledge_studio
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000

# --- Sessions & security ----------------------------------------------------------------
# REQUIRED. At least 32 random characters. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_COOKIE_NAME=ks_session
CSRF_COOKIE_NAME=ks_csrf
SESSION_TTL_HOURS=336
SESSION_IDLE_TIMEOUT_HOURS=72
SESSION_ROTATE_AFTER_MINUTES=720
# Sensitive actions (plan edits, account deletion) need a password confirmation within this window
REAUTH_WINDOW_MINUTES=15
# Leave empty: defaults to Secure cookies outside development/test
COOKIE_SECURE=
# Set to a parent domain (e.g. .example.com) only if the web and API hosts differ
COOKIE_DOMAIN=
EMAIL_VERIFICATION_REQUIRED=0
# Default for Admin > Settings > Sign-ups. 0 closes registration.
REGISTRATION_ENABLED=1
PASSWORD_MIN_LENGTH=10

# --- Google OAuth (optional) -------------------------------------------------------------
# When 0, the Google button is hidden and OAuth endpoints refuse to start a flow.
GOOGLE_AUTH_ENABLED=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the authorised redirect URI in Google Cloud Console, e.g.
# http://localhost:3000/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=

# --- Email -----------------------------------------------------------------------------
# none: nothing is sent (the UI says so) | console: logged, development only | smtp
EMAIL_PROVIDER=none
EMAIL_FROM=Knowledge Studio <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=1

# --- File storage ------------------------------------------------------------------------
# No object store is needed. These are defaults: administrators choose the location and
# whether originals are kept in Admin > Settings, without a restart.
# local:   a folder on the server (LOCAL_STORAGE_DIR). API and worker must share that disk.
# mongodb: inside the database (GridFS). Works when API and workers run on different servers.
# s3:      optional; any S3-compatible store, configured with the S3_* settings below.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/storage
# 0: delete an uploaded file once its text and vectors are indexed (answers, citations,
#    research and the graph work from the indexed text). 1: keep it for download and export.
KEEP_ORIGINAL_FILES=0
# With KEEP_ORIGINAL_FILES=0, a file that failed processing is kept this long so it can be retried.
FAILED_ORIGINAL_RETENTION_DAYS=7
S3_BUCKET=
S3_REGION=
# Leave empty for AWS; set for R2/B2/MinIO, e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=300
# Platform ceiling for any single upload, regardless of plan (bytes). 200 MiB:
UPLOAD_HARD_MAX_BYTES=209715200

# --- Embeddings ----------------------------------------------------------------------------
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# 128-3072; Google recommends 768, 1536 or 3072. MUST match the Atlas vector index.
# Changing it requires a re-index migration (admin panel > System), never an in-place edit.
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_API_KEY=
# Optional explicit embedding-space id; derived as provider:model:dims when empty
EMBEDDING_SPACE_ID=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_CONCURRENCY=2
EMBEDDING_REQUESTS_PER_MINUTE=300

# --- Generative AI -------------------------------------------------------------------------
# Separate providers/models for answers, research and extraction. Only "gemini" is
# implemented end to end; "none" disables that capability with a clear error.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Falls back to GEMINI_API_KEY when empty
LLM_API_KEY=
RESEARCH_LLM_PROVIDER=gemini
# Empty = same as LLM_MODEL
RESEARCH_LLM_MODEL=
EXTRACTION_LLM_PROVIDER=gemini
EXTRACTION_LLM_MODEL=
# Reranking is optional and not configured by default
RERANKER_PROVIDER=none
RERANKER_MODEL=
LLM_TIMEOUT_SECONDS=90
LLM_MAX_CONCURRENCY=4

# --- Retrieval ---------------------------------------------------------------------------
# atlas: Atlas Vector Search ($vectorSearch). exact: in-database cosine for local dev/tests
# only (refused in production).
VECTOR_SEARCH_BACKEND=atlas
# atlas: Atlas Search ($search). text_index: MongoDB $text fallback.
KEYWORD_SEARCH_BACKEND=atlas
ATLAS_VECTOR_INDEX_NAME=chunks_vector_v1
ATLAS_SEARCH_INDEX_NAME=chunks_text_v1
VECTOR_FIELD=embedding
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATES=40
CONTEXT_MAX_TOKENS=12000
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
# Bump when changing chunking so outdated files can be reprocessed
CHUNKING_VERSION=struct-v1
MAX_CHUNKS_PER_INGESTION=20000
# OCR adapter for scanned PDFs (none = scanned PDFs are reported as needing OCR)
OCR_PROVIDER=none

# --- Paddle Billing ------------------------------------------------------------------------
# When 0, billing is disabled and clearly labelled; no subscription can be created.
PADDLE_ENABLED=0
# sandbox | production
PADDLE_ENVIRONMENT=sandbox
# Server-side API key (Paddle > Developer tools > Authentication)
PADDLE_API_KEY=
# Client-side token for Paddle.js (safe to expose; starts with test_ or live_)
PADDLE_CLIENT_TOKEN=
# Notification destination secret (Paddle > Developer tools > Notifications)
PADDLE_WEBHOOK_SECRET=
PADDLE_WEBHOOK_TOLERANCE_SECONDS=5
# Optional bootstrap: mapped to the seeded Premium plan on first setup-db.
# Afterwards manage mappings in Admin > Paddle prices.
PADDLE_PRICE_ID_PREMIUM_MONTHLY=
PADDLE_PRICE_ID_PREMIUM_YEARLY=
BILLING_PAST_DUE_GRACE_DAYS=3

# --- Background jobs -------------------------------------------------------------------------
QUEUE_BACKEND=mongodb
WORKER_CONCURRENCY=2
# 1: run the worker inside the API process (single-service hosting; see docs/deployment.md).
RUN_WORKER_IN_API=0
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=5
JOB_POLL_INTERVAL_SECONDS=1.0

# --- Rate limits ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=1
RATE_LIMIT_LOGIN_PER_15M=10
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# --- Platform cost safety -----------------------------------------------------------------
# Hard monthly ceiling on estimated AI spend across all users (USD). Per-user budgets are
# configured per plan in the admin panel.
PLATFORM_MONTHLY_AI_BUDGET_USD=200

# --- Exports ----------------------------------------------------------------------------
# TTF font with coverage for your languages, used for PDF report export. Empty = auto-detect
# (DejaVu Sans on Linux, Sylfaen on Windows, which covers Georgian).
PDF_FONT_PATH=

# --- Monitoring (optional) ---------------------------------------------------------------
# Sentry is used only when SENTRY_DSN is set and `pip install sentry-sdk` was run.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Feature flags -----------------------------------------------------------------------
# External web research is not implemented in this release; keep 0.
FEATURE_WEB_RESEARCH=0
FEATURE_GRAPH_EXTRACTION=1
